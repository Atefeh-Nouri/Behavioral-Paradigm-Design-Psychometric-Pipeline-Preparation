# ==============================================================================
# renv Local Activation Hook
# Activates the project-local R package library upon working directory load.
# ==============================================================================

if (file.exists("analysis_r/renv/activate.R")) {
  source("analysis_r/renv/activate.R")
} else if (file.exists("renv/activate.R")) {
  source("renv/activate.R")
}
